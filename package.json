{
  "name": "venus-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter @contentstack/venuscn build && pnpm --filter @contentstack/venusmui build && pnpm --filter demo build",
    "build:packages": "pnpm --filter @contentstack/venuscn build && pnpm --filter @contentstack/venusmui build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @contentstack/venuscn typecheck && pnpm --filter @contentstack/venusmui typecheck && pnpm --filter demo typecheck",
    "test": "pnpm --filter demo test",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "clean": "pnpm -r exec rm -rf node_modules .next dist",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx,css}' 'apps/*/src/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx,css}' 'apps/*/src/**/*.{ts,tsx,css}'"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "prettier": "^3.8.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.9.0"
  }
}
